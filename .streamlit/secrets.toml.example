# Copy to .streamlit/secrets.toml in a deployment environment only.
# Never commit the real secrets file or SMTP credentials.

MOBRA_AUTHOR_EMAIL = "modiabat@gmail.com"

# Optional email-backup settings. Keep disabled unless institutionally authorized.
MOBRA_EMAIL_ENABLED = "false"
MOBRA_SMTP_HOST = ""
MOBRA_SMTP_PORT = "587"
MOBRA_SMTP_USERNAME = ""
MOBRA_SMTP_PASSWORD = ""
MOBRA_SMTP_FROM = ""
MOBRA_SMTP_USE_TLS = "true"
